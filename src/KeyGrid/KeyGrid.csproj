<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KeyGrid.Core\KeyGrid.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the MIT notice in both local publish output and release archives. -->
    <None Include="..\..\LICENSE"
          Link="LICENSE"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- The tray loads this file directly: the apphost exe has no
         RT_GROUP_ICON resource for LoadImage to resolve. -->
    <None Include="..\..\assets\icon.ico"
          Link="icon.ico"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>

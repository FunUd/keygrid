<Window x:Class="KeyGrid.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KeyGrid.UI"
        Title="KeyGrid Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="True"
        UseLayoutRounding="True">
    <Grid>
        <ui:OverlayRenderElement x:Name="RenderElement" />
    </Grid>
</Window>
